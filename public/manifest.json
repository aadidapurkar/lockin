{
    "manifest_version": 3,
    "name": "Lockin",
    "version": "1.0.0",
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "service_worker.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "webNavigation"
    ],
    "icons": {
        "128": "icon.png"
    }
}
