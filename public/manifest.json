{
    "manifest_version": 3,
    "name": "Lockin",
    "version": "1.5",
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "service_worker.js"
    },
    "permissions": ["activeTab", "storage", "tabs", "webNavigation"],
    "icons": {
        "128": "icon.png"
    },
    "commands" : {
        "lock-tab": {
            "suggested_key": {
                "default": "Alt+Shift+L"
            },
            "description": "Toggle the lock state of the currently focused tab"
        }
    }
}
